&share
  wrf_core = 'ARW',
  max_dom = 3,
  start_date = '2009-05-01_00:00:00','2009-05-01_00:00:00','2009-05-01_00:00:00','2022-12-15_00:00:00','2022-12-15_00:00:00','2022-12-15_00:00:00',
  end_date   =  '2010-07-01_00:00:00','2010-07-01_00:00:00','2010-07-01_00:00:00','2022-12-18_00:00:00','2022-12-18_00:00:00','2022-12-18_00:00:00',
  interval_seconds = 21600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,  2, 
 parent_grid_ratio =   1,   3,  3, 
 i_parent_start       = 1, 14, 19
 j_parent_start       = 1, 14, 18
 e_we                 = 42, 46, 25
 e_sn                 = 41, 46, 25
 geog_data_res     = 'usgs_lakes+30s','usgs_lakes+30s','usgs_lakes+30s','usgs_lakes+30s',
 dx = 9000,
 dy =9000,
 map_proj = 'lambert',
 ref_lat   =  44.143,
 ref_lon   =   116.315,
 truelat1  =  30,
 truelat2  =  60,
 stand_lon =  116.315,
 geog_data_path ='/data/home/maguolin/WPS_GEOG/',
! opt_geogrid_tbl_path='/public1/home/sc50311/WRF-setups/WPS_GEOG/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE', 
 io_form_metgrid = 2,
 !constants_name = 'LSM:1989-01-01_12', 'Z:1989-01-01_12'
/


